    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "type": "module",
  "description": "Map of well-reviewed local spots, colored by distance from home."
